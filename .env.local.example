NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-key

# Optional: Radix Gateway Basic Auth (for private/authenticated gateway nodes)
# Leave empty to use the public Radix Gateway without authentication
GATEWAY_AUTH_USER=
GATEWAY_AUTH_PASS=

# Optional: Override pino log level (debug | info | warn | error)
LOG_LEVEL=info
