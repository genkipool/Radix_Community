# Resend API Key for Email Sending
# Get yours at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Vercel and Cron Secrets
# A secure random string for authenticating cron jobs
CRON_SECRET=your_secure_cron_secret_here


# Storage Vervel Upstash radix-list-validators-fallback-storage
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_URL=""
REDIS_URL=""
KV_REST_API_READ_ONLY_TOKEN=""


NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""


# Radix dApp Definition Addresses
NEXT_PUBLIC_RADIX_DAPP_ADDRESS_MAINNET=""
NEXT_PUBLIC_RADIX_DAPP_ADDRESS_STOKENET=""


# Radix Seal brand-resource address per network (the open-mint soulbound
# insignia collection). Set after the one-time deploy; leave empty when the
# brand is not deployed on that network (the insignia check is then skipped).
NEXT_PUBLIC_RADIX_SEAL_MAINNET=""
NEXT_PUBLIC_RADIX_SEAL_STOKENET=""


# RFC 3161 Time Stamping Authority used to date OFF-ledger signatures (an
# on-ledger one is dated by the transaction that minted it). Server side only:
# the browser cannot reach a TSA directly, so the app relays the round trip, and
# only a hash of the signature is ever sent. Defaults to freetsa.org.
# SIGN_TSA_URL="https://freetsa.org/tsr"
#
# Extra trust anchors, as comma-separated SHA-256 fingerprints of the topmost
# certificate a token chains to. The Free TSA root and DigiCert Trusted Root G4
# are built in; a token from any other anchor still verifies cryptographically,
# it is just reported as one this deployment does not recognise.
# SIGN_TSA_ANCHORS=""


# WebRTC ICE servers for the encrypt-document tool (optional).
# Defaults mirror the Radix Rust SDK connect crate: Google STUN + the public
# metered.ca TURN relay. Set these to use your own infrastructure.
# NEXT_PUBLIC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# NEXT_PUBLIC_TURN_URL="turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443?transport=tcp"
# NEXT_PUBLIC_TURN_USERNAME=""
# NEXT_PUBLIC_TURN_CREDENTIAL=""

# ── Protocol-update signalling (validator "vote" button in staking) ──────────
# The EXACT 32-character protocol version name validators signal on-ledger via
# signal_protocol_update_readiness. Must be exactly 32 chars or the ledger
# rejects it; leave empty to hide the vote action. Update per network upgrade.
NEXT_PUBLIC_PROTOCOL_UPDATE_SIGNAL=""
# Human-friendly label shown on the badge once signalled (e.g. "Cuttlefish").
NEXT_PUBLIC_PROTOCOL_UPDATE_NAME=""
